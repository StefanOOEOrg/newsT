# Copy this file to .env and fill in the two required values.
#
# Every variable below is read by Settings in src/newstrading/config.py; nothing
# else is read from the environment. Required variables abort the command with
# exit code 2 when they are missing or empty; optional variables fall back to
# their default when they are absent or empty.
#
# Notification channels (email, SMS, push, webhook) are not environment
# variables: they are rows of the notification_settings table in sql/schema.sql.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://trading:trading123@localhost:5432/newstrading
ANTHROPIC_API_KEY=your_anthropic_key

# --- Optional: analysis -----------------------------------------------------
# AI_MODEL=claude-3-5-haiku-20241022
# MAX_TOKENS=512
# ANALYSIS_INTERVAL_MINUTES=5
# CONTENT_MAX_LENGTH=2000
# ALERT_SUMMARY_MAX_LENGTH=180

# --- Optional: logging ------------------------------------------------------
# LOG_LEVEL=INFO
# DATABASE_LOG_LEVEL=INFO

# --- Optional: data sources -------------------------------------------------
# Empty disables the source; RSS and the public congressional disclosures need
# no key and always run.

# NewsAPI - 100 requests/day on the free tier
# Get from: https://newsapi.org/register
# NEWSAPI_KEY=your_newsapi_key

# Finnhub - 60 calls/minute on the free tier
# Get from: https://finnhub.io/register
# FINNHUB_API_KEY=your_finnhub_key

# Alpha Vantage - 25 calls/day on the free tier (includes sentiment)
# Get from: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=your_alphavantage_key

# Congressional trades - premium source; empty keeps the public House Stock
# Watcher data only
# CONGRESS_TRADES_API_KEY=your_congress_trades_key
# CONGRESS_TRADES_API_URL=https://your-premium-endpoint.example.com/trades
