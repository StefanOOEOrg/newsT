# Database Configuration
DATABASE_URL=postgresql://trading:trading123@postgres:5432/newstrading

# Anthropic API Key (REQUIRED for AI analysis)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# ============================================================================
# Data Source API Keys (Optional - enable collectors in collector/config.py)
# ============================================================================

# RSS Feeds (ENABLED by default - no API key needed)
# Sources: Google News, Yahoo Finance, Seeking Alpha

# NewsAPI (Optional) - 100 requests/day free tier
# Get from: https://newsapi.org/register
# NEWSAPI_KEY=your_newsapi_key

# Finnhub (Optional) - 60 calls/minute free tier
# Get from: https://finnhub.io/register
# FINNHUB_API_KEY=your_finnhub_key

# Alpha Vantage (Optional) - 25 calls/day free tier (includes sentiment!)
# Get from: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=your_alphavantage_key

# Congressional Trades (Optional)
# House Stock Watcher: Free public data (used by default, no API key needed)
# Alternative APIs if needed:
#   - Benzinga Government Trades API: https://www.benzinga.com/apis/cloud-product/government-trades/
#   - Financial Modeling Prep Senate API: https://site.financialmodelingprep.com/developer/docs/senate-trading-api
# CONGRESS_TRADES_API_KEY=your_api_key_if_using_premium_source

# Reddit API (Optional - requires approval)
# Get from: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_secret
# REDDIT_USER_AGENT=newstrading-bot/1.0

# Twitter/X API (Optional)
# Get from: https://developer.twitter.com/
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ============================================================================
# Notification Settings (Optional - for alert notifications)
# ============================================================================

# Email Notifications (Recommended)
# NOTIFICATION_EMAIL=your.email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM=your.email@gmail.com

# SMS Notifications via Twilio (Optional)
# Get from: https://www.twilio.com/try-twilio
# NOTIFICATION_PHONE=+1234567890
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1987654321

# Push Notifications via Pushover (Optional)
# Get from: https://pushover.net/
# PUSHOVER_TOKEN=your_pushover_app_token
# PUSHOVER_USER=your_pushover_user_key

# Webhook Notifications (Optional)
# Custom HTTP endpoint to receive alert notifications
# WEBHOOK_URL=https://your-endpoint.com/alerts

# Notification Service Configuration
# NOTIFICATION_CHECK_INTERVAL=5  # Minutes between notification checks
