# Copy this file to .env and fill in DATABASE_URL.
#
# Every variable below is read by Settings in src/newstrading/config.py; nothing
# else is read from the environment. Required variables abort the command with
# exit code 2 when they are missing or empty; optional variables fall back to
# their default when they are absent or empty. Only DATABASE_URL is always
# required.
#
# Notification channels are not configured through environment variables: the
# rows of the notification_settings table (one per sender) hold their settings
# and enable/disable flags.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://trading:***@localhost:5432/newstrading

# --- Optional: analysis -----------------------------------------------------
# Base URL of the OpenAI-compatible chat-completions endpoint and the model id
# it answers with. The default points at gb10-writing on the GX10.
# LLM_BASE_URL=http://192.168.178.87:8004/v1
# LLM_MODEL=gb10-writing
# Bearer token of the endpoint; it may stay empty, then no Authorization header
# is sent.
# LLM_API_KEY=
# Seconds one model call may take.
# LLM_TIMEOUT=60
# Maximum tokens of one answer; leave room for the reasoning prefix.
# LLM_MAX_TOKENS=1024
# Model calls in flight in one analyze pass, between 1 and 16.
# LLM_MAX_CONCURRENCY=1
# Optional fallback endpoint, used when the primary call fails in a way a retry
# can fix. LLM_FALLBACK_MODEL defaults to LLM_MODEL; the key may stay empty.
# LLM_FALLBACK=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEY=
# The LLM_* values can also be given per run as flags of `analyze`, for example
# a higher token budget or more concurrent model calls for one pass.
# ANALYSIS_INTERVAL_MINUTES=5
# CONTENT_MAX_LENGTH=2000
# ALERT_SUMMARY_MAX_LENGTH=180
# LOG_LEVEL=INFO
# DATABASE_LOG_LEVEL=INFO

# --- Optional: news sources -------------------------------------------------
# Every collector is only built when its key is set. The RSS feed and the
# congressional trades need no key and always run; the premium congressional
# trades source is enabled with CONGRESS_TRADES_API_KEY and an optional
# CONGRESS_TRADES_API_URL.
# NEWSAPI_KEY=
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=
# CONGRESS_TRADES_API_KEY=
# CONGRESS_TRADES_API_URL=

# --- Optional: database schema ----------------------------------------------
# The dashboard is read-only; it runs on 127.0.0.1:8088 and is started with
# `newstrading dashboard` (optionally with --port). The API lives under /api.
# sql/schema.sql and sql/reset.sql are applied only by `newstrading init-db`.